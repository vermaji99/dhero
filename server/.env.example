
# Database (MongoDB Atlas / MongoDB)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/dhero?retryWrites=true&w=majority&appName=Cluster0"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS (set to your deployed frontend URL, e.g. "https://leadflow.vercel.app")
CORS_ORIGIN="https://your-frontend-domain.vercel.app"

# Port (local dev only, not used in Vercel serverless)
PORT=3000

# Demo Passwords (for seed script — optional for production)
ADMIN_PASSWORD="demo-admin-123"
MEMBER_PASSWORD="demo-member-123"
