# Copy this file to `.env` and fill in real values.
#
# ⚠️  CRITICAL: Do NOT wrap values in surrounding double-quotes ("...").
# Vercel Environment Variables store the value verbatim, so if you paste
#   DATABASE_URL="mongodb+srv://user:pass@host/..."
# including the surrounding double-quotes, Prisma reads a string starting
# with '"' not 'mongodb+srv://' and throws:
#   Error P1012: Error validating datasource `db`: the URL must start with
#   the protocol `mongo`.

DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=Cluster0

# JWT signing — change this on Vercel to a long random string (32+ chars).
JWT_SECRET=change-me-in-production-and-local
JWT_EXPIRES_IN=7d

# Comma separated list of allowed origins. Wildcard globs supported (e.g. https://*.vercel.app).
# On Vercel set this exactly to your client domain:
#   CORS_ORIGIN=https://dhero-client.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

PORT=3000

# Only used by seed.ts when seeding demo users. Can be empty after DB is seeded.
ADMIN_PASSWORD=demo-admin-123
MEMBER_PASSWORD=demo-member-123
