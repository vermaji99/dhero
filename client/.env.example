
# Deployed backend API base URL (NestJS Vercel serverless project)
# NOTE: client code does `fetch(VITE_API_URL + endpoint)` where endpoint
# starts with `/`. Since Vercel function files live under api/ and route
# to /api/*, the full prefix must be host + /api (not host alone).
VITE_API_URL=https://dhero-server-gamma.vercel.app/api
